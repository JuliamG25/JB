---
import TestButton from '../components/TestButton';
---

<div class="min-h-screen bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md space-y-6">
    <div>
      <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent mb-4">
        Test de Tailwind
      </h1>
      <p class="text-gray-600 mb-6">Si ves este texto con estilos, Tailwind está funcionando en Astro.</p>
      <button class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-xl font-semibold hover:from-purple-700 hover:to-pink-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
        Botón Astro
      </button>
    </div>
    <hr class="border-gray-300" />
    <div>
      <h2 class="text-2xl font-bold mb-4">Test Componente React:</h2>
      <TestButton client:load />
    </div>
  </div>
</div>

