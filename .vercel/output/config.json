{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "render"
		},
		{
			"src": "^\\/api\\/entradas\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/api\\/ganancias\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/api\\/productos\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/api\\/salidas\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/entradas\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/ganancias\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/salidas\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/test-tailwind\\/?$",
			"dest": "render"
		},
		{
			"src": "^\\/$",
			"dest": "render"
		}
	]
}